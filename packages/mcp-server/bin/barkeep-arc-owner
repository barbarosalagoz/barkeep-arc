#!/bin/sh
# The owner's command: open, fund and close tabs with the owner key. Run it
# yourself in a terminal; it is not part of the MCP server. See src/owner/cli.ts.
set -eu
# npm and npx run this through a symlink in node_modules/.bin, so $0 is not where this file is. Follow the links first.
self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
here=$(cd "$(dirname "$self")/.." && pwd -P)
tsx="$here/../../node_modules/.bin/tsx"
[ -x "$tsx" ] || { echo "barkeep-arc-owner: $tsx not found; run npm ci at the repo root" >&2; exit 1; }
exec "$tsx" "$here/src/owner/cli.ts" "$@"
