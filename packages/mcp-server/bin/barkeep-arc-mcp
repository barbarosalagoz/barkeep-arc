#!/bin/sh
# Launch the Barkeep on Arc MCP server. It needs no secret: the only keys it uses
# are per-tab agent keys it makes itself. Register it with:
#
#   claude mcp add barkeep-arc --scope local -- /absolute/path/to/packages/mcp-server/bin/barkeep-arc-mcp
#
# stdout is the MCP channel: everything this script says goes to stderr.
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
tsx="$here/../../node_modules/.bin/tsx"
[ -x "$tsx" ] || { echo "barkeep-arc-mcp: $tsx not found; run npm ci at the repo root" >&2; exit 1; }
exec "$tsx" "$here/src/index.ts"
