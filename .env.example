# Copy to .env (git-ignored). No real values belong in this file.
# Private keys are NOT configured here: they live in ~/.local/state/barkeep-arc/keys.json, mode 600.

# Arc RPC endpoints (public defaults shown)
ARC_TESTNET_RPC=https://rpc.testnet.arc.io
ARC_MAINNET_RPC=https://rpc.mainnet.arc.io

# Local Arc chain the contract tests fork from: arc-anvil --network arc --port 8555
ARC_ANVIL_RPC=http://127.0.0.1:8555
